  <excludesAllergen rdf:resource="#alg_gluten"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gluten-free</rdfs:label>
  <curatorNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gluten-free means below 20 ppm gluten in the US, Canada and EU. It does not mean wheat-free.</curatorNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#claim_dairy_free">
  <rdf:type rdf:resource="#DairyFreeClaim"/>
  <excludesAllergen rdf:resource="#alg_milk"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dairy-free</rdfs:label>
  <curatorNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No US regulatory definition; consumers read it as milk-free, so milk is treated as excluded.</curatorNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#claim_nut_free">
  <rdf:type rdf:resource="#NutFreeClaim"/>
  <excludesAllergen rdf:resource="#alg_tree_nuts"/>
  <excludesAllergen rdf:resource="#alg_peanut"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nut-free</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#claim_peanut_free">
  <rdf:type rdf:resource="#PeanutFreeClaim"/>
  <excludesAllergen rdf:resource="#alg_peanut"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peanut-free</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#claim_egg_free">
  <rdf:type rdf:resource="#EggFreeClaim"/>
  <excludesAllergen rdf:resource="#alg_egg"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Egg-free</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#claim_soy_free">
  <rdf:type rdf:resource="#SoyFreeClaim"/>
  <excludesAllergen rdf:resource="#alg_soy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soy-free</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#claim_lactose_free">
  <rdf:type rdf:resource="#LactoseFreeClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lactose-free</rdfs:label>
  <curatorNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An intolerance claim about milk sugar. It says nothing about milk protein, so lactose-free milk is still a milk allergen.</curatorNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#claim_non_dairy">
  <rdf:type rdf:resource="#NonDairyClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-dairy (US term)</rdfs:label>
  <curatorNote rdf:datatype="http://www.w3.org/2001/XMLSchema#string">US regulatory term that permits caseinates, a milk protein (21 CFR 101.4(d)). Not a safety claim.</curatorNote>
</owl:NamedIndividual>

