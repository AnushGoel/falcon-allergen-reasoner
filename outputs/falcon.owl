<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/anushgoel/ontologies/2026/falcon.owl"
         xmlns="http://www.semanticweb.org/anushgoel/ontologies/2026/falcon.owl#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://www.semanticweb.org/anushgoel/ontologies/2026/falcon.owl">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FALCON: Food Allergen and Label COmpliance ONtology. 45 products, 149 ingredients, 28 allergens, 3 jurisdictions (US, Canada, EU).</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasIngredient">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Ingredient"/>
  <owl:inverseOf rdf:resource="#isIngredientOf"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredient appearing in a product's (flattened) ingredient list.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isIngredientOf">
  <rdfs:domain rdf:resource="#Ingredient"/>
  <rdfs:range rdf:resource="#Product"/>
  <owl:inverseOf rdf:resource="#hasIngredient"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inverse of hasIngredient.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasComponent">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Ingredient"/>
  <rdfs:range rdf:resource="#Ingredient"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Component of a compound ingredient (mayonnaise has component egg yolk).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#derivedFrom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Ingredient"/>
  <rdfs:range rdf:resource="#Ingredient"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Provenance: the raw material an ingredient was made from.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#triggersAllergen">
  <rdfs:domain rdf:resource="#Ingredient"/>
  <rdfs:range rdf:resource="#Allergen"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#retainsAllergensOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#triggersAllergen"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#hasComponent"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#triggersAllergen"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredient carries this allergen.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#possiblyTriggers">
  <rdfs:domain rdf:resource="#Ingredient"/>
  <rdfs:range rdf:resource="#Allergen"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Allergen the ingredient may carry depending on an unstated source.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isSubtypeOf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Allergen"/>
  <rdfs:range rdf:resource="#Allergen"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Allergen grouping, e.g. hazelnut isSubtypeOf tree nuts.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#containsAllergen">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Allergen"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#containsAllergen"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#isSubtypeOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred: the product contains the allergen.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mayContain">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Allergen"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#mayContain"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#isSubtypeOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Precautionary ('may contain') labelling.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasLabelClaim">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#LabelClaim"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#excludesAllergen">
  <rdfs:domain rdf:resource="#LabelClaim"/>
  <rdfs:range rdf:resource="#Allergen"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Allergen a free-from claim rules out.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contradictsClaim">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#LabelClaim"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred: composition contradicts the claim.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#precautionaryConflictWith">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#LabelClaim"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred: a 'may contain' statement undermines the claim.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#soldIn">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Jurisdiction"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requiresDeclarationOf">
  <rdfs:domain rdf:resource="#Jurisdiction"/>
  <rdfs:range rdf:resource="#Allergen"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mustDeclare">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Allergen"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred declaration duty in at least one market.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#declaresAllergen">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Allergen"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Allergen the printed label actually declares.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mustAvoid">
  <rdfs:domain rdf:resource="#Consumer"/>
  <rdfs:range rdf:resource="#Allergen"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#unsafeFor">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Consumer"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred: contains something the consumer must avoid.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#cautionFor">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Consumer"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred: may contain something the consumer must avoid.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#unsuitableForDietOf">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Consumer"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inCategory">
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#ProductCategory"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exemptIngredient">
  <rdfs:domain rdf:resource="#DeclarationExemption"/>
  <rdfs:range rdf:resource="#Ingredient"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exemptAllergen">
  <rdfs:domain rdf:resource="#DeclarationExemption"/>
  <rdfs:range rdf:resource="#Allergen"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exemptJurisdiction">
  <rdfs:domain rdf:resource="#DeclarationExemption"/>
  <rdfs:range rdf:resource="#Jurisdiction"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#retainsAllergensOf">
  <rdfs:subPropertyOf rdf:resource="#derivedFrom"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Ingredient"/>
  <rdfs:range rdf:resource="#Ingredient"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Derivation that keeps the source's allergenic proteins. Highly refined oils are derivedFrom soybean but do not retainAllergensOf it.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mustDeclareInUS">
  <rdfs:subPropertyOf rdf:resource="#mustDeclare"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Allergen"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mustDeclareInCanada">
  <rdfs:subPropertyOf rdf:resource="#mustDeclare"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Allergen"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#mustDeclareInEU">
  <rdfs:subPropertyOf rdf:resource="#mustDeclare"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="#Allergen"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasBarcode">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasIngredientListStatus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">'complete' or 'incomplete'; decides where closed-world reasoning is allowed.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasGlutenPPM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lab-measured gluten, mg/kg.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSulphiteMgPerKg">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Product"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Total SO2, mg/kg.</rdfs:comment>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#regulatoryBasis"/>

<owl:AnnotationProperty rdf:about="#scenarioNote"/>

<owl:AnnotationProperty rdf:about="#synonym"/>

<owl:AnnotationProperty rdf:about="#curatorNote"/>

<owl:Class rdf:about="#FoodEntity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Food Entity</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anything that appears on a food label: finished products and the ingredients in them.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Product">
  <rdfs:subClassOf rdf:resource="#FoodEntity"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasBarcode"/>
      <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#soldIn"/>
      <owl:onClass rdf:resource="#Jurisdiction"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#inCategory"/>
      <owl:onClass rdf:resource="#ProductCategory"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Product</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A packaged food product as offered to consumers.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Ingredient">
  <rdfs:subClassOf rdf:resource="#FoodEntity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ingredient kind such as whey or tahini. Kinds are individuals, not classes, so that SWRL rules (which only bind named individuals) can reason about them.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PlantDerivedIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Plant Derived Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredient obtained from plants.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CerealIngredient">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cereal Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cereal grains and products made from them.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LegumeIngredient">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Legume Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Legumes such as soy, peanut, lupin, pea and chickpea.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TreeNutIngredient">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tree Nut Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tree nuts and nut products.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SeedIngredient">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seed Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seeds such as sesame, mustard and sunflower.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#VegetableIngredient">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegetable Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegetables.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FruitIngredient">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fruit Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fruits and fruit-derived ingredients.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PlantOilOrFat">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Plant Oil Or Fat</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegetable oils and fats.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SugarOrSweetener">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sugar Or Sweetener</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sugars and syrups.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#HerbOrSpice">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Herb Or Spice</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Herbs, spices and extracts.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CocoaIngredient">
  <rdfs:subClassOf rdf:resource="#PlantDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cocoa Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cocoa mass, powder and butter.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AnimalDerivedIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Animal Derived Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredient obtained from animals.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#VegetarianIncompatibleIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegetarian Incompatible Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredient vegetarians avoid: meat, fish, shellfish, slaughter by-products and insect-derived additives.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DairyIngredient">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dairy Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Milk and milk-derived ingredients.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EggIngredient">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Egg Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Eggs and egg-derived ingredients.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FishIngredient">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:subClassOf rdf:resource="#VegetarianIncompatibleIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fish Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fish and fish products.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CrustaceanIngredient">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:subClassOf rdf:resource="#VegetarianIncompatibleIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crustacean Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crustaceans.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MolluscIngredient">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:subClassOf rdf:resource="#VegetarianIncompatibleIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mollusc Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molluscs.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MeatIngredient">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:subClassOf rdf:resource="#VegetarianIncompatibleIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meat Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meat.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SlaughterByproduct">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:subClassOf rdf:resource="#VegetarianIncompatibleIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slaughter Byproduct</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gelatin, lard, animal rennet and similar by-products of slaughter.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InsectDerivedIngredient">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:subClassOf rdf:resource="#VegetarianIncompatibleIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insect Derived Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Additives made from insects, e.g. carmine (E120) and shellac (E904).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BeeProduct">
  <rdfs:subClassOf rdf:resource="#AnimalDerivedIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bee Product</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Honey, beeswax and other bee products (vegetarian, not vegan).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OtherOriginIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Other Origin Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredients that are neither plant nor animal derived.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MineralOrSyntheticIngredient">
  <rdfs:subClassOf rdf:resource="#OtherOriginIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mineral Or Synthetic Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Water, salt, minerals and synthetic additives.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MicrobialIngredient">
  <rdfs:subClassOf rdf:resource="#OtherOriginIngredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microbial Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Yeast and ingredients made by microbial fermentation.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CompoundIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Compound Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ingredient that is itself a recipe, e.g. mayonnaise or milk chocolate.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UnspecifiedOriginIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unspecified Origin Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ingredient whose source a label does not reveal (e.g. 'lecithin', E471). Deliberately NOT disjoint from the origin classes: the origin is unknown, not absent.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GlutenSourceIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gluten Source Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredient that delivers gluten to the finished food.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LactoseSourceIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lactose Source Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ingredient that delivers lactose to the finished food.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Allergen">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Allergen</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A food allergen or hazard that some consumers must avoid.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AllergenCategory">
  <rdfs:subClassOf rdf:resource="#Allergen"/>
  <owl:disjointWith rdf:resource="#SpecificAllergen"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Allergen Category</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A regulated allergen group, e.g. milk, tree nuts.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SpecificAllergen">
  <rdfs:subClassOf rdf:resource="#Allergen"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specific Allergen</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A named member of a group, e.g. hazelnut, rye.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LabelClaim">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Label Claim</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A statement printed on a label.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DietClaim">
  <rdfs:subClassOf rdf:resource="#LabelClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diet Claim</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diet suitability claim.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#VeganClaim">
  <rdfs:subClassOf rdf:resource="#DietClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegan Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VegetarianClaim">
  <rdfs:subClassOf rdf:resource="#DietClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegetarian Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#FreeFromClaim">
  <rdfs:subClassOf rdf:resource="#LabelClaim"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#excludesAllergen"/>
      <owl:onClass rdf:resource="#Allergen"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Free From Claim</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Claim that the product is free of named allergens.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GlutenFreeClaim">
  <rdfs:subClassOf rdf:resource="#FreeFromClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gluten Free Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#DairyFreeClaim">
  <rdfs:subClassOf rdf:resource="#FreeFromClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dairy Free Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NutFreeClaim">
  <rdfs:subClassOf rdf:resource="#FreeFromClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nut Free Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PeanutFreeClaim">
  <rdfs:subClassOf rdf:resource="#FreeFromClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peanut Free Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#EggFreeClaim">
  <rdfs:subClassOf rdf:resource="#FreeFromClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Egg Free Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SoyFreeClaim">
  <rdfs:subClassOf rdf:resource="#FreeFromClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soy Free Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#IntoleranceClaim">
  <rdfs:subClassOf rdf:resource="#LabelClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intolerance Claim</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Claim aimed at an intolerance rather than an allergy.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LactoseFreeClaim">
  <rdfs:subClassOf rdf:resource="#IntoleranceClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lactose Free Claim</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#RegulatedMarketingTerm">
  <rdfs:subClassOf rdf:resource="#LabelClaim"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regulated Marketing Term</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A term with a legal definition that is not a safety claim.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NonDairyClaim">
  <rdfs:subClassOf rdf:resource="#RegulatedMarketingTerm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non Dairy Claim</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">US 'non-dairy' (21 CFR 101.4(d)); may contain caseinate.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Jurisdiction">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jurisdiction</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A regulatory market.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#USJurisdiction">
  <rdfs:subClassOf rdf:resource="#Jurisdiction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USJurisdiction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#CanadaJurisdiction">
  <rdfs:subClassOf rdf:resource="#Jurisdiction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Canada Jurisdiction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#EUJurisdiction">
  <rdfs:subClassOf rdf:resource="#Jurisdiction"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EUJurisdiction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Consumer">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Consumer</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A consumer profile with allergies or dietary choices.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#VegetarianConsumer">
  <rdfs:subClassOf rdf:resource="#Consumer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegetarian Consumer</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VeganConsumer">
  <rdfs:subClassOf rdf:resource="#VegetarianConsumer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegan Consumer</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ProductCategory">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Product Category</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Retail category used for grouping analyses.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DeclarationExemption">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#exemptIngredient"/>
      <owl:onClass rdf:resource="#Ingredient"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#exemptAllergen"/>
      <owl:onClass rdf:resource="#Allergen"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#exemptJurisdiction"/>
      <owl:onClass rdf:resource="#Jurisdiction"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Declaration Exemption</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reified n-ary relation (ingredient, allergen, jurisdiction). OWL properties are binary, so a three-way fact needs its own individual (W3C N-ary Relations pattern).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MeetsGlutenFreeThreshold">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meets Gluten Free Threshold</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lab result below 20 ppm gluten.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SulphiteAtOrAbove10ppm">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sulphite At Or Above10ppm</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Total sulphites of 10 ppm or more (US and Canada trigger).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SulphiteAbove10ppm">
  <rdfs:subClassOf rdf:resource="#SulphiteAtOrAbove10ppm"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sulphite Above10ppm</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Total sulphites above 10 mg/kg (EU trigger).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NonVeganIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#AnimalDerivedIngredient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasComponent"/>
          <owl:someValuesFrom rdf:resource="#AnimalDerivedIngredient"/>
        </owl:Restriction>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non Vegan Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Animal-derived, or a compound with an animal-derived component (at any depth, since hasComponent is transitive).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NonVegetarianIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#VegetarianIncompatibleIngredient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasComponent"/>
          <owl:someValuesFrom rdf:resource="#VegetarianIncompatibleIngredient"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#derivedFrom"/>
          <owl:someValuesFrom rdf:resource="#VegetarianIncompatibleIngredient"/>
        </owl:Restriction>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non Vegetarian Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Covers hidden cases such as parmesan made with animal rennet.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#VeganSafeIngredient">
  <rdfs:subClassOf rdf:resource="#Ingredient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#PlantDerivedIngredient"/>
        <rdf:Description rdf:about="#OtherOriginIngredient"/>
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#CompoundIngredient"/>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasComponent"/>
              <owl:allValuesFrom>
                <owl:Class>
                  <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#PlantDerivedIngredient"/>
                    <rdf:Description rdf:about="#OtherOriginIngredient"/>
                  </owl:unionOf>
                </owl:Class>
              </owl:allValuesFrom>
            </owl:Restriction>
          </owl:intersectionOf>
        </owl:Class>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegan Safe Ingredient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The compound case uses 'only' (a universal restriction): OWL can conclude it only after the compound's component list is closed.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NonVeganProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasIngredient"/>
          <owl:someValuesFrom rdf:resource="#NonVeganIngredient"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non Vegan Product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#NonVegetarianProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasIngredient"/>
          <owl:someValuesFrom rdf:resource="#NonVegetarianIngredient"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non Vegetarian Product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#OriginUncertainProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasIngredient"/>
          <owl:someValuesFrom>
            <owl:Class>
              <owl:unionOf rdf:parseType="Collection">
                <rdf:Description rdf:about="#UnspecifiedOriginIngredient"/>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#hasComponent"/>
                  <owl:someValuesFrom rdf:resource="#UnspecifiedOriginIngredient"/>
                </owl:Restriction>
              </owl:unionOf>
            </owl:Class>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Origin Uncertain Product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#VeganCompatibleProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasIngredient"/>
          <owl:someValuesFrom rdf:resource="#Ingredient"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasIngredient"/>
          <owl:allValuesFrom rdf:resource="#VeganSafeIngredient"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vegan Compatible Product</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Universal restriction: under the open-world assumption no product is ever classified here unless its ingredient list is closed. The engine's VerifiedVeganProduct is the closed-world counterpart.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GlutenContainingProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasIngredient"/>
          <owl:someValuesFrom rdf:resource="#GlutenSourceIngredient"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#containsAllergen"/>
      <owl:hasValue rdf:resource="#alg_gluten"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gluten Containing Product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AllergenContainingProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#containsAllergen"/>
          <owl:someValuesFrom rdf:resource="#Allergen"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Allergen Containing Product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PrecautionaryLabelledProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#mayContain"/>
          <owl:someValuesFrom rdf:resource="#Allergen"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Precautionary Labelled Product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ClaimConflictProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#contradictsClaim"/>
          <owl:someValuesFrom rdf:resource="#LabelClaim"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Claim Conflict Product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#PrecautionaryConflictProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#precautionaryConflictWith"/>
          <owl:someValuesFrom rdf:resource="#LabelClaim"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Precautionary Conflict Product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MultiMarketProduct">
  <rdfs:subClassOf rdf:resource="#Product"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Product"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#soldIn"/>
          <owl:onClass rdf:resource="#Jurisdiction"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Multi Market Product</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qualified cardinality; relies on AllDifferent over jurisdictions because OWL has no unique name assumption.</rdfs:comment>
</owl:Class>

